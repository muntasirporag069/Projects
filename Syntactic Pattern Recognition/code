import numpy as np
import pandas as pd
from collections import Counter
from sklearn.model_selection import StratifiedKFold, train_test_split
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
from sklearn.ensemble import RandomForestClassifier
from sklearn.naive_bayes import MultinomialNB
from sklearn.svm import SVC
from sklearn.preprocessing import LabelEncoder
from sklearn.impute import SimpleImputer
from sklearn.pipeline import Pipeline
import random

SEED = 42
np.random.seed(SEED)
random.seed(SEED)

DATA_PATH = "/kaggle/input/datasets/sooryaprakash12/human-dna-sequences/human_data.txt"
SEQ_COL = "sequence"
LABEL_COL = "class"
TOKENIZER_NAME = "zhihan1996/DNA_bert_6"
KMER = 6

def load_dnabert_tokenizer():
    from transformers import AutoTokenizer
    tok = AutoTokenizer.from_pretrained(TOKENIZER_NAME, trust_remote_code=True)
    print(f"Loaded DNABERT tokenizer vocabulary: {tok.vocab_size} tokens")
    return tok

def seq2kmer_string(seq, k=KMER):
    seq = seq.upper().replace("N", "A")
    if len(seq) < k:
        return ""
    return " ".join(seq[i:i + k] for i in range(len(seq) - k + 1))

def tokenize_with_dnabert_vocab(seq, tokenizer):
    kmer_text = seq2kmer_string(seq)
    if not kmer_text:
        return []
    tokens = tokenizer.tokenize(kmer_text)
    return [t for t in tokens if t not in tokenizer.all_special_tokens]

class TrigramGrammarModel:
    def __init__(self, alpha=1.0):
        self.alpha = alpha
        self.bigram = Counter()
        self.trigram = Counter()
        self.vocab = set()
        self.V = 0

    def fit(self, token_sequences):
        for tokens in token_sequences:
            if len(tokens) == 0:
                continue
            padded = ["<s>", "<s>"] + tokens + ["</s>"]
            self.vocab.update(tokens)
            for i in range(len(padded) - 2):
                a, b, c = padded[i], padded[i + 1], padded[i + 2]
                self.bigram[(a, b)] += 1
                self.trigram[(a, b, c)] += 1
        self.V = max(len(self.vocab) + 1, 1)
        return self

    def log_likelihood(self, tokens):
        if len(tokens) == 0:
            return -1e9
        padded = ["<s>", "<s>"] + tokens + ["</s>"]
        ll = 0.0
        for i in range(len(padded) - 2):
            a, b, c = padded[i], padded[i + 1], padded[i + 2]
            tri = self.trigram.get((a, b, c), 0)
            bi = self.bigram.get((a, b), 0)
            prob = (tri + self.alpha) / (bi + self.alpha * self.V)
            ll += np.log(prob)
        return ll

class DnaBertGrammarFeatureExtractor:
  def __init__(self, tokenizer):
      self.tokenizer = tokenizer
      self.classes = None
      self.models = {}

  def fit(self, sequences, labels):
      token_seqs = [tokenize_with_dnabert_vocab(s, self.tokenizer) for s in sequences]
      self.classes = sorted(pd.unique(labels))
      for c in self.classes:
          class_tokens = [t for t, y in zip(token_seqs, labels) if y == c]
          self.models[c] = TrigramGrammarModel(alpha=1.0).fit(class_tokens)
      return self

  def transform(self, sequences):
      rows = []
      for s in sequences:
          tokens = tokenize_with_dnabert_vocab(s, self.tokenizer)
          row = [self.models[c].log_likelihood(tokens) for c in self.classes]
          rows.append(row)
      return pd.DataFrame(rows, columns=[f"loglik_{c}" for c in self.classes])

def load_data():
    df = pd.read_csv(DATA_PATH, sep="\t")
    df.columns = [c.strip().lower() for c in df.columns]
    df = df.dropna(subset=[SEQ_COL, LABEL_COL]).reset_index(drop=True)
    df[SEQ_COL] = df[SEQ_COL].astype(str).str.strip().str.upper()
    print(f"Loaded {len(df)} sequences across {df[LABEL_COL].nunique()} classes:")
    print(df[LABEL_COL].value_counts().sort_index())
    return df

def augment_dna_sequence(seq, k=3, max_mutations=3):
    seq = seq.upper().replace("N", "A")
    L = len(seq)
    if L < k:
        return seq
    seq_list = list(seq)
    mutations = random.randint(1, max_mutations)
    for _ in range(mutations):
        pos = random.randint(0, L - k)
        num_changes = random.choice([1, 2])
        indices = random.sample(range(pos, pos + k), num_changes)
        for idx in indices:
            orig = seq_list[idx]
            choices = [b for b in "ACGT" if b != orig]
            seq_list[idx] = random.choice(choices)
    return "".join(seq_list)

def balance_dataset_with_synthetic(
    df,
    seq_col=SEQ_COL,
    label_col=LABEL_COL,
    target_ratio=1.0,
    k_augment=3,
    max_augment_per_seq=5,
    verbose=True
):
    df = df.copy()
    counts = df[label_col].value_counts()
    if verbose:
        print("Original class distribution:")
        print(counts)

    max_count = counts.max()
    target_count = int(max_count * target_ratio)

    new_rows = []

    for cls, grp in df.groupby(label_col):
        n = len(grp)
        if n >= target_count:
            grp_sample = grp.sample(n=target_count, random_state=SEED)
            new_rows.append(grp_sample)
            if verbose:
                print(f"Class {cls}: undersampled from {n} -> {target_count}")
        else:
            new_rows.append(grp)
            needed = target_count - n
            seqs = grp[seq_col].tolist()
            synth_seqs = []
            while len(synth_seqs) < needed:
                base_seq = random.choice(seqs)
                aug_seq = augment_dna_sequence(
                    base_seq,
                    k=k_augment,
                    max_mutations=max_augment_per_seq
                )
                synth_seqs.append(aug_seq)

            synth_df = pd.DataFrame({
                seq_col: synth_seqs[:needed],
                label_col: cls
            })
            new_rows.append(synth_df)
            if verbose:
                print(f"Class {cls}: original {n}, added {needed} synthetic -> total {n + needed}")
              
df_balanced = pd.concat(new_rows, ignore_index=True)
 if verbose:
        print("\nBalanced class distribution:")
        print(df_balanced[label_col].value_counts().sort_index())
    return df_balanced

def make_rf_model():
    return Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("rf", RandomForestClassifier(
            n_estimators=300,
            random_state=SEED,
            n_jobs=-1,
            class_weight="balanced_subsample"
        ))
    ])

def make_nb_model():
    return Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("shift", Shifter()),
        ("nb", MultinomialNB(alpha=1.0))
    ])

def make_svm_model():
    return Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("svm", SVC(
            kernel="rbf",
            C=1.0,
            gamma="scale",
            random_state=SEED,
            class_weight="balanced",
            probability=False
        ))
    ])

class Shifter:
    def __init__(self):
        self.offset_ = None
    def fit(self, X, y=None):
        self.offset_ = -X.min(axis=0)
        self.offset_[self.offset_ < 0] = 0
        return self
    def transform(self, X):
        return X + self.offset_
    def fit_transform(self, X, y=None):
        self.fit(X, y)
        return self.transform(X)

def extract_features_and_labels(train_seqs, train_labels, test_seqs, test_labels, tokenizer):
    feat = DnaBertGrammarFeatureExtractor(tokenizer)
    X_train = feat.fit(train_seqs, train_labels).transform(train_seqs)
    X_test = feat.transform(test_seqs)

    le = LabelEncoder()
    y_train = le.fit_transform(train_labels)
    y_test = le.transform(test_labels)

    return X_train, X_test, y_train, y_test, le, feat


def evaluate_model_holdout(X_train, X_test, y_train, y_test, model, model_name, le):
    model.fit(X_train, y_train)
    
    train_preds = model.predict(X_train)
    train_acc = accuracy_score(y_train, train_preds)
    
    test_preds = model.predict(X_test)
    test_acc = accuracy_score(y_test, test_preds)

    print(f"\n=== {model_name} ===")
    print(f"TRAINING ACCURACY: {train_acc:.4f}")
    print(f"TEST ACCURACY:     {test_acc:.4f}")
    print(f"GENERALIZATION GAP (Train - Test): {train_acc - test_acc:.4f}")
    
    class_names = [str(c) for c in le.classes_]

    print(classification_report(
        y_test,
        test_preds,
        labels=list(range(len(class_names))),
        target_names=class_names,
        zero_division=0
    ))

    print("Confusion matrix:")
    print(pd.DataFrame(
        confusion_matrix(y_test, test_preds),
        index=class_names,
        columns=class_names
    ))
    
    return train_acc, test_acc 

if __name__ == "__main__":
    tokenizer = load_dnabert_tokenizer()
    df = load_data()

    df_balanced = balance_dataset_with_synthetic(
        df,
        seq_col=SEQ_COL,
        label_col=LABEL_COL,
        target_ratio=1.0,
        k_augment=3,
        max_augment_per_seq=5,
        verbose=True
    )

    train_df, test_df = train_test_split(
        df_balanced, test_size=0.2, stratify=df_balanced[LABEL_COL], random_state=SEED
    )

    X_train, X_test, y_train, y_test, le, feat = extract_features_and_labels(
        train_df[SEQ_COL].tolist(),
        train_df[LABEL_COL].tolist(),
        test_df[SEQ_COL].tolist(),
        test_df[LABEL_COL].tolist(),
        tokenizer
    )

    models_holdout = [
        ("Multinomial Naive Bayes", make_nb_model()),
        ("Random Forest", make_rf_model()),
        ("SVM (RBF)", make_svm_model()),
    ]

    # Store results for a final summary table
    results = []

    for name, model in models_holdout:
        train_acc, test_acc = evaluate_model_holdout(
            X_train, X_test, y_train, y_test, model, name, le
        )
        results.append({
            "Model": name,
            "Train Acc": train_acc,
            "Test Acc": test_acc,
            "Gap": train_acc - test_acc
        })

    # Final Summary Table
    print("\n" + "="*60)
    print("FINAL ACCURACY SUMMARY (TRAIN vs TEST)")
    print("="*60)
    summary_df = pd.DataFrame(results)
    print(summary_df.to_string(index=False))

